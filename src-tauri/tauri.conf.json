{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Academiq",
  "version": "1.0.0",
  "identifier": "com.academiq.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev || npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build || npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Academiq — Academic Operating System",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Academiq Campus ERP & Academic Operating System",
    "longDescription": "Academiq Institutional ERP Desktop System for academic administration, admissions, fees, faculty, and circulars."
  }
}
